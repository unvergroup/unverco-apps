{
  "_aciklama": "Yeni uygulama eklemek: apps listesine bir nesne ekleyin (qa/README.md). Adim turleri: goto (#/yol), click, wait, waitGone, sleep(ms), shot, check(true=yerlesim denetimi). rapid:true tik korumasini beklemeden tiklar.",
  "apps": [
    {
      "id": "habit",
      "name": "2027 Habit Tracker",
      "dir": "habit-tracker-2027",
      "version_regex": "VERSION\\s*=\\s*\"([^\"]+)\"",
      "version_file": "sw.js",
      "main": "#panel",
      "journey": [
        {
          "label": "Karsilama ekrani",
          "wait": "#w-start",
          "check": true,
          "shot": "01-karsilama"
        },
        {
          "label": "Ornek yil yukle",
          "click": "#w-sample"
        },
        {
          "label": "Bugun ekrani",
          "wait": "#hero",
          "sleep": 500,
          "check": true,
          "shot": "02-bugun"
        },
        {
          "label": "Ay ekrani",
          "click": [
            "#tab-month",
            "#nav-month"
          ],
          "sleep": 700,
          "check": true,
          "shot": "03-ay"
        },
        {
          "label": "Yil ekrani",
          "click": [
            "#tab-year",
            "#nav-year"
          ],
          "sleep": 700,
          "check": true,
          "shot": "04-yil"
        },
        {
          "label": "Aliskanliklar ekrani",
          "click": [
            "#tab-habits",
            "#nav-habits"
          ],
          "wait": "#habit-list",
          "check": true,
          "shot": "05-aliskanliklar"
        },
        {
          "label": "Daha fazla ekrani",
          "click": [
            "#tab-more",
            "#nav-more"
          ],
          "sleep": 700,
          "check": true,
          "shot": "06-daha-fazla"
        },
        {
          "label": "Bugune don",
          "click": [
            "#tab-today",
            "#nav-today"
          ],
          "wait": "#hero"
        }
      ],
      "persistence": {
        "label": "Bir aliskanligi isaretle, sayfayi yenile",
        "steps": [
          {
            "click": "[id^=chk-]"
          },
          {
            "sleep": 800
          }
        ],
        "probe": "#hero",
        "ready": "#hero"
      },
      "offline": {
        "ready": "#hero"
      },
      "print": [
        {
          "label": "Yili yazdir, Letter belge",
          "steps": [
            {
              "goto": "#/year"
            },
            {
              "wait": "#y-print"
            },
            {
              "click": "#y-print"
            },
            {
              "sleep": 1300
            }
          ],
          "pages": 1,
          "papers": [
            "Letter",
            "8.5x10.8in"
          ]
        },
        {
          "label": "Yili yazdir, Letter belge A4 kagida (uyumsuz kagit)",
          "steps": [
            {
              "goto": "#/year"
            },
            {
              "wait": "#y-print"
            },
            {
              "click": "#y-print"
            },
            {
              "sleep": 1300
            }
          ],
          "pages": 1,
          "papers": [
            "A4"
          ]
        }
      ]
    },
